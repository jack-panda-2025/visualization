# 复制为 .env 并填写真实值

# AWS S3
S3_ENDPOINT_URL=              # 留空使用 AWS；阿里云 OSS 填 https://oss-cn-hangzhou.aliyuncs.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_PREFIX=simulations/        # 桶内子目录（末尾加 /），留空则扫描整个桶

SIGNED_URL_EXPIRES=3600       # 签名 URL 有效期（秒）

# 允许的前端域名（逗号分隔）
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
